node_modules/
data/
.env
*.log

# Compiled output of studio-web TypeScript sources. These get emitted by
# stray `tsc -b` invocations and silently shadow .tsx files via Vite's
# resolve order. studio-web source is .ts/.tsx only; never commit a .js
# sibling under src/. Cost a full diagnostic session before being caught.
studio-web/src/**/*.js
studio-web/src/**/*.js.map
studio-web/src/**/*.d.ts

.squash/

# scip code-index artifacts (emitted by squash/scip indexing) and macOS junk.
*.typescript.scip
*.scip
# Scratch copies the indexer leaves behind, e.g. docs/login.squash_0.js. They
# land in docs/, which is SERVED, so an accidental commit publishes a stray
# duplicate of a real page's script.
*.squash_*.js
.DS_Store

# Productizer hygiene pattern list — names private strings, must never be committed.
.claude/productizer/hygiene-local.txt
